<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.MiptCalculator" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/calc_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/calc_background</item>
        <item name="colorPrimary">@color/calc_btn_equals_bg</item>
    </style>

    <style name="Theme.MiptCalculator" parent="Base.Theme.MiptCalculator" />

    <!-- Button styles -->
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">#E0E0E0</item>
        <item name="elevation">1dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButton">
        <item name="backgroundTint">@color/calc_btn_num_bg</item>
        <item name="android:textColor">@color/calc_btn_num_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">@color/calc_btn_op_bg</item>
        <item name="android:textColor">@color/calc_btn_op_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/calc_btn_equals_bg</item>
        <item name="android:textColor">@color/calc_btn_equals_text</item>
        <item name="android:textSize">22sp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CalcButton.Memory" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textColor">@color/calc_mem_text_enabled</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
